SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Optional overrides (defaults shown)
MATCHING_CITY=Москва
MATCHING_MIN_GROUP_SIZE=4
MATCHING_TARGET_GROUP_SIZE=5
MATCHING_MAX_GROUP_SIZE=6
MATCHING_HOBBY_THRESHOLD=0.10
MATCHING_HOBBY_WEIGHT=0.65
MATCHING_WORK_WEIGHT=0.35
MATCHING_USER_INACTIVE_DAYS=30
MATCHING_NO_REPEAT_DAYS=7
MATCHING_MIN_DISTRICT_SIZE=3

# External APIs (required for restaurant selection)
TWOGIS_API_KEY=your-2gis-api-key
YANDEX_MAPS_KEY=your-yandex-maps-key
ANTHROPIC_API_KEY=your-anthropic-api-key
